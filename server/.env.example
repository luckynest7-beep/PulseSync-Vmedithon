PORT=8000

# From https://aistudio.google.com/apikey (free tier). Leave blank to run
# with safe stub responses (extraction returns "unknown", insight is generic).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# From your Supabase project settings > API. Leave both blank to run the
# API with an in-memory readings store (fine for a local demo, resets on restart).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
