PORT=8000

# From https://aistudio.google.com/apikey (free tier). Leave blank to run
# with safe stub responses (extraction returns "unknown", insight is generic).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Firebase Admin service account. Get it from: Firebase Console > Project
# Settings > Service Accounts > "Generate new private key" (downloads a
# .json file). Leave both blank to run with an in-memory readings store
# (fine for a local demo, resets on restart).
#
# Local dev: save the downloaded file as server/firebase-service-account.json
# (already git-ignored) and point at it — no editing/minifying required.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
#
# Cloud hosts (Render, etc.) that only support env vars, not file uploads:
# paste the file's full contents here as one line instead, and leave the
# PATH variable above blank.
FIREBASE_SERVICE_ACCOUNT_KEY=
