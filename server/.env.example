PORT=8000

# From https://aistudio.google.com/apikey (free tier). Leave blank to run
# with safe stub responses (extraction returns "unknown", insight is generic).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Firebase Admin service account, as one single-line JSON string.
# Get it from: Firebase Console > Project Settings > Service Accounts >
# "Generate new private key" (downloads a .json file — paste its full
# contents here on one line). Leave blank to run with an in-memory readings
# store (fine for a local demo, resets on restart).
FIREBASE_SERVICE_ACCOUNT_KEY=
