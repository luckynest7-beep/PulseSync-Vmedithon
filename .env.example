# Base URL of the PulseSync API (see server/). Leave blank in local dev —
# vite.config.ts already proxies /api to http://localhost:8000.
# Set this to your deployed backend URL when building for production.
VITE_API_URL=

# Firebase client config — from Firebase Console > Project Settings > General
# > "Your apps" (add a Web app if you don't have one yet). These are public
# values (safe to ship in the browser bundle); security comes from Firebase
# Auth + Firestore rules, not from hiding them.
#
# Leave ALL of these blank to skip login entirely and use the app exactly as
# before (local/mock data, no auth gate) — nothing breaks if you don't set
# these up.
#
# Also required: enable the Email/Password sign-in provider at
# Firebase Console > Authentication > Sign-in method > Email/Password.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
